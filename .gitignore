*.zip
*.pt
*.ckpt
__pycache__/
.venv/

# Leading slash anchors this to the repo root. Unanchored `data/` also matched
# `src/data/`, silently excluding download.py and clean.py from the repo.
/data/

# Codabench artifacts are all regenerated output, and large: the folder holds
# 2.0 GB of predictions (MINDlarge_test 291 MB raw / 106 MB zipped, EB-NeRD
# testset 703 MB raw / 226 MB zipped). Q8 keeps large files out of git.
# Regenerate with:
#   python src/submission/generate_predictions.py --config config/<ds>.yaml
#   python src/submission/predict_raw_mind.py --dir data/raw/mind/MINDlarge_test
#   python src/data/download.py --id ebnerd_testset
#   python src/submission/predict_ebnerd_test.py --dir data/raw/ebnerd/ebnerd_testset
reports/submissions/

# logs/ is tracked: 132 KB of plain text that records every training and
# evaluation run (seed, per-epoch loss, final metrics with CIs). It is the
# evidence behind the numbers in the reports, so it belongs in the repo.
# Keep it that way only while it stays small and text-only.

# macOS Finder metadata
.DS_Store

# LaTeX build byproducts (the .tex and .pdf are committed).
reports/design_note/*.log
reports/design_note/*.aux
reports/design_note/*.out
reports/design_note/*.toc
