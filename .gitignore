*.zip
*.pt
*.ckpt
__pycache__/
.venv/

# Leading slash anchors this to the repo root. Unanchored `data/` also matched
# `src/data/`, silently excluding download.py and clean.py from the repo.
/data/

# The zip is the Codabench deliverable; the loose .txt inside it is redundant
# and 8 MB, so keep only the archive (Q8: no large files in git).
reports/submissions/*.txt

# MINDlarge_test predictions are 291 MB raw / 106 MB zipped - far past what
# belongs in git. Regenerate with:
#   python src/submission/predict_raw_mind.py --dir data/raw/mind/MINDlarge_test
reports/submissions/*mind_large_test*

# EB-NeRD official testset predictions: 703 MB raw / 226 MB zipped. Regenerate:
#   python src/data/download.py --id ebnerd_testset
#   python src/submission/predict_ebnerd_test.py --dir data/raw/ebnerd/ebnerd_testset
reports/submissions/*ebnerd_testset*
